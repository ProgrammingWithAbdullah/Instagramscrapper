# Your own Instagram Business/Creator account ID (the "calling" account for Business
# Discovery — not an account you're monitoring). Get it from Graph API Explorer:
# GET me/accounts?fields=name,instagram_business_account
IG_BUSINESS_ACCOUNT_ID=

# A long-lived User Access Token (60 days) for the app above, generated with these
# permissions: instagram_basic, instagram_manage_insights, pages_read_engagement,
# pages_show_list, business_management. See README for how to get a long-lived one
# instead of the 1-hour token Graph API Explorer gives you by default.
IG_ACCESS_TOKEN=

# Gemini API key (https://aistudio.google.com/apikey) used to generate the
# "why this post worked" breakdown shown in the post detail modal.
GEMINI_API_KEY=

# Upstash Redis (via the Vercel Marketplace "Upstash" integration, or a
# standalone database at upstash.com) — this is where synced posts and
# generated breakdowns are stored. Same two values whether you're running
# locally or on Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: protects the Vercel Cron sync endpoint (app/api/cron/sync) from
# being triggered by anyone who finds the URL. Vercel sets this for you
# automatically and attaches it to cron requests — you don't need to set it
# yourself unless you're calling that endpoint manually for testing.
CRON_SECRET=
